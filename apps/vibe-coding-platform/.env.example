# Rube Goldberg Vibe Coding Platform — Environment Variables
# Copy this file to .env and fill in your values

# Required: Anthropic API key for Claude Agent SDK
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Workspace directory where agent builds code
WORKSPACE_DIR=./workspaces

# SQLite database path for session persistence
DB_PATH=./sessions.db

# Max concurrent sessions
MAX_SESSIONS=10

# Default max iterations (user can override per session)
DEFAULT_MAX_ITERATIONS=25
